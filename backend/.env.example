# Copy this file to backend/.env. Keep real connection details out of Git.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fld_primary
DB_USER=postgres
DB_PASSWORD=
# Alternatively set DATABASE_URL through your deployment secret store.
# DATABASE_URL=

PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# Exact frontend origins, without trailing slashes. Never use * with credentials.
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500
# Production: NODE_ENV=production and APP_ORIGINS=https://your-portal.example
# Set TRUST_PROXY only to the actual trusted reverse proxy IP/subnet.
# TRUST_PROXY=loopback
